<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SerialScout.App.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="1080"
        d:DesignHeight="680"
        x:Class="SerialScout.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1080"
        Height="680"
        MinWidth="720"
        MinHeight="480"
        Title="Serial Scout"
        Name="Shell">
  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding Devices.RefreshCommand}" />
  </Window.KeyBindings>

  <DockPanel Margin="8">
    <!-- Error banner: always text, dismissible via keyboard. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Padding="10,6"
            Background="#3FDB3C3C"
            CornerRadius="4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding LastError}"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="Error message" />
        <Button Grid.Column="1"
                Content="Dismiss"
                Margin="8,0,0,0"
                Click="OnDismissError"
                AutomationProperties.Name="Dismiss error banner" />
      </Grid>
    </Border>

    <TabControl SelectedIndex="{Binding SelectedTabIndex}">

      <!-- ===== Devices ===== -->
      <TabItem Header="Devices">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Refresh scan"
                    Command="{Binding Devices.RefreshCommand}"
                    KeyboardNavigation.TabIndex="0"
                    AutomationProperties.Name="Refresh device scan (F5)" />
            <Button Content="New profile from selection" Click="OnDraftFromSelection"
                    AutomationProperties.Name="Create profile draft from selected device" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Devices.StatusText}" />
          </StackPanel>

          <ListBox Grid.Row="1"
                   Margin="0,8"
                   ItemsSource="{Binding Devices.Devices}"
                   SelectedItem="{Binding Devices.SelectedDevice}"
                   AutomationProperties.Name="Discovered devices">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceRow">
                <StackPanel Spacing="2" Margin="2">
                  <TextBlock Text="{Binding AccessibilitySummary}"
                             AutomationProperties.Name="{Binding AccessibilitySummary}" />
                  <TextBlock FontSize="11"
                             Opacity="0.8"
                             Text="{Binding DescriptionLabel}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ListBox Grid.Row="2"
                   MaxHeight="180"
                   ItemsSource="{Binding SessionHistory}"
                   AutomationProperties.Name="Past sessions">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionHistoryRow">
                <TextBlock Text="{Binding AccessibilitySummary}"
                           AutomationProperties.Name="{Binding AccessibilitySummary}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <!-- ===== Profiles ===== -->
      <TabItem Header="Profiles">
        <ScrollViewer Margin="0,8,0,0">
          <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock FontSize="18" Text="{Binding Editor.Title}" />
            <TextBlock Text="Names and rules stay in the local database on this machine."
                       Opacity="0.8" />

            <TextBlock Classes="field-label" Text="Profile name" Margin="0,6,0,2" />
            <TextBox
                     Text="{Binding Editor.NameText}"
                     Watermark="e.g. Lab ESP32"
                     AutomationProperties.Name="Profile name" />

            <Grid ColumnDefinitions="*,*">
              <TextBlock Classes="field-label" Text="Vendor id (hex or decimal)" Margin="0,6,0,2" />
              <TextBox Grid.Column="0"
                       Text="{Binding Editor.VendorIdText}"
                       Watermark="1A86"
                       Margin="0,0,8,0"
                       AutomationProperties.Name="USB vendor id" />
              <TextBlock Classes="field-label" Text="Product id (hex or decimal)" Margin="0,6,0,2" />
              <TextBox Grid.Column="1"
                       Text="{Binding Editor.ProductIdText}"
                       Watermark="7523"
                       AutomationProperties.Name="USB product id" />
            </Grid>

            <TextBlock Classes="field-label" Text="Serial fingerprint (optional, exact binding)" Margin="0,6,0,2" />
            <TextBox
                     Text="{Binding Editor.SerialFingerprint}"
                     AutomationProperties.Name="Serial number fingerprint" />
            <TextBlock Classes="field-label" Text="Product hint (optional substring)" Margin="0,6,0,2" />
            <TextBox
                     Text="{Binding Editor.ProductHint}"
                     AutomationProperties.Name="Product name hint" />
            <TextBlock Classes="field-label" Text="Manufacturer hint (optional substring)" Margin="0,6,0,2" />
            <TextBox
                     Text="{Binding Editor.ManufacturerHint}"
                     AutomationProperties.Name="Manufacturer hint" />

            <Grid ColumnDefinitions="*,*,*,*">
              <TextBlock Classes="field-label" Text="Baud" Margin="0,6,0,2" />
              <ComboBox Grid.Column="0"
                        ItemsSource="{Binding Editor.BaudRateChoices}"
                        SelectedItem="{Binding Editor.BaudRateText}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Default baud rate" />
              <TextBlock Classes="field-label" Text="Data bits" Margin="0,6,0,2" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding Editor.DataBitsChoices}"
                        SelectedIndex="{Binding Editor.DataBitsIndex}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Data bits" />
              <TextBlock Classes="field-label" Text="Parity" Margin="0,6,0,2" />
              <ComboBox Grid.Column="2"
                        ItemsSource="{Binding Editor.ParityChoices}"
                        SelectedIndex="{Binding Editor.ParityIndex}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Parity" />
              <TextBlock Classes="field-label" Text="Stop bits" Margin="0,6,0,2" />
              <ComboBox Grid.Column="3"
                        ItemsSource="{Binding Editor.StopBitsChoices}"
                        SelectedIndex="{Binding Editor.StopBitsIndex}"
                        AutomationProperties.Name="Stop bits" />
            </Grid>

            <TextBlock Classes="field-label" Text="Line ending for sends" Margin="0,6,0,2" />
            <ComboBox
                      ItemsSource="{Binding Editor.LineEndingChoices}"
                      SelectedIndex="{Binding Editor.LineEndingIndex}"
                      Width="160"
                      HorizontalAlignment="Left"
                      AutomationProperties.Name="Default line ending" />

            <TextBlock Classes="field-label" Text="Notes" Margin="0,6,0,2" />
            <TextBox
                     Text="{Binding Editor.Notes}"
                     AcceptsReturn="True"
                     MinHeight="52"
                     AutomationProperties.Name="Profile notes" />

            <TextBlock Text="{Binding Editor.ValidationText}"
                       Foreground="#E57373"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Editor.PreviewText}"
                       TextWrapping="Wrap"
                       Opacity="0.9" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Save profile"
                      Command="{Binding Editor.SaveCommand}"
                      AutomationProperties.Name="Save profile" />
              <Button Content="Delete profile"
                      Command="{Binding Editor.DeleteCommand}"
                      IsEnabled="{Binding Editor.IsExisting}"
                      AutomationProperties.Name="Delete profile" />
              <Button Content="New / reset"
                      Command="{Binding Editor.ResetCommand}"
                      AutomationProperties.Name="Clear editor for a new profile" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===== Terminal ===== -->
      <TabItem Header="Terminal">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Connect"
                    Command="{Binding Terminal.ConnectCommand}"
                    AutomationProperties.Name="Connect to selected device" />
            <Button Content="Disconnect"
                    Command="{Binding Terminal.DisconnectCommand}"
                    AutomationProperties.Name="Disconnect session" />
            <Button Content="Reconnect"
                    Command="{Binding Terminal.ReconnectCommand}"
                    AutomationProperties.Name="Reconnect session" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Terminal.StatusText}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Terminal.ProfileLabel}" />
          </StackPanel>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8">
            <ComboBox ItemsSource="{Binding Terminal.BaudRateChoices}"
                      SelectedIndex="{Binding Terminal.BaudIndex}"
                      AutomationProperties.Name="Session baud rate" />
            <ComboBox ItemsSource="{Binding Terminal.LineEndingChoices}"
                      SelectedIndex="{Binding Terminal.LineEndingIndex}"
                      AutomationProperties.Name="Session line ending" />
            <CheckBox IsChecked="{Binding Terminal.AutoReconnect}"
                      Content="Auto-reconnect"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Automatically reconnect after drops" />
          </StackPanel>

          <TextBox Grid.Row="2" Grid.ColumnSpan="2"
                   Text="{Binding Terminal.LogText, Mode=OneWay}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   FontFamily="Consolas,Menlo,monospace"
                   Watermark="Session log (RX/TX)"
                   AutomationProperties.Name="Session log, newest at bottom" />

          <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
            <TextBox Grid.Column="0"
                     Text="{Binding Terminal.LogFilter}"
                     Watermark="Filter log (case-insensitive)"
                     AutomationProperties.Name="Filter log text" />
            <Button Grid.Column="1" Content="Preview export..." Margin="8,0,0,0"
                    Click="OnOpenPrivacy"
                    AutomationProperties.Name="Open privacy preview for session export" />
            <TextBox Grid.Column="2" Width="260"
                     Text="{Binding Terminal.SendText}"
                     Watermark="Send text (Enter sends)"
                     AutomationProperties.Name="Text to send">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding Terminal.SendCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ===== Privacy / export ===== -->
      <TabItem Header="Privacy &amp; Export">
        <ScrollViewer Margin="0,8,0,0">
          <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock FontSize="18" Text="Local export, backup, and retention" />
            <TextBlock Text="Nothing is uploaded. Redaction changes export copies only; stored originals remain unchanged."
                       TextWrapping="Wrap" Opacity="0.85" />
            <TextBlock Text="Session logs and profiles are stored in the local Serial Scout data directory. See README Privacy, storage, and retention for platform paths."
                       TextWrapping="Wrap" Opacity="0.85" />

            <Border BorderBrush="#607D8B" BorderThickness="1" CornerRadius="4" Padding="10">
              <StackPanel Spacing="8">
                <TextBlock FontSize="16" Text="Selected-session export" />
                <Button Content="Refresh stored sessions" Click="OnRefreshPrivacySessions"
                        HorizontalAlignment="Left" AutomationProperties.Name="Refresh locally stored sessions" />
                <ComboBox ItemsSource="{Binding Privacy.Sessions}"
                          SelectedItem="{Binding Privacy.SelectedSession}"
                          DisplayMemberBinding="{Binding Label}"
                          MinWidth="520"
                          AutomationProperties.Name="Session to export" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox ItemsSource="{Binding Privacy.RedactionPresetChoices}"
                            SelectedIndex="{Binding Privacy.RedactionPresetIndex}"
                            Width="200" AutomationProperties.Name="Redaction preset" />
                  <ComboBox ItemsSource="{Binding Privacy.ExportFormatChoices}"
                            SelectedIndex="{Binding Privacy.ExportFormatIndex}"
                            Width="160" AutomationProperties.Name="Export format" />
                  <Button Content="Create preview" Click="OnCreateExportPreview"
                          AutomationProperties.Name="Create redacted export preview" />
                </StackPanel>
                <TextBox Text="{Binding Privacy.ExportPreviewText, Mode=OneWay}"
                         IsReadOnly="True" AcceptsReturn="True" MinHeight="150" MaxHeight="260"
                         FontFamily="Consolas,Menlo,monospace"
                         Watermark="Preview appears here. No export is possible before review."
                         AutomationProperties.Name="Exact export preview" />
                <CheckBox IsChecked="{Binding Privacy.IsExportConfirmed}"
                          Content="I reviewed this exact preview and want to export it"
                          AutomationProperties.Name="Confirm reviewed export preview" />
                <Button Content="Export reviewed copy..." Click="OnWriteExport"
                        IsEnabled="{Binding Privacy.CanWriteExport}" HorizontalAlignment="Left"
                        AutomationProperties.Name="Write confirmed export to local file" />
              </StackPanel>
            </Border>

            <Border BorderBrush="#B26A00" BorderThickness="1" CornerRadius="4" Padding="10">
              <StackPanel Spacing="8">
                <TextBlock FontSize="16" Text="Sensitive backup and restore" />
                <TextBlock Text="{Binding Privacy.BackupWarningText}" TextWrapping="Wrap" Foreground="#F0A040" />
                <TextBlock Text="Exports and backups never overwrite existing files. Choose a new destination name; the active database and its sidecars are blocked."
                           TextWrapping="Wrap" />
                <Button Content="Create backup preview" Click="OnCreateBackupPreview"
                        HorizontalAlignment="Left" AutomationProperties.Name="Preview sensitive local backup" />
                <TextBox Text="{Binding Privacy.BackupPreviewText, Mode=OneWay}"
                         IsReadOnly="True" AcceptsReturn="True" MinHeight="100" MaxHeight="220"
                         FontFamily="Consolas,Menlo,monospace"
                         Watermark="Versioned backup JSON appears here."
                         AutomationProperties.Name="Exact sensitive backup preview" />
                <CheckBox IsChecked="{Binding Privacy.IsSensitiveBackupConfirmed}"
                          Content="I understand this backup contains sensitive raw data"
                          AutomationProperties.Name="Acknowledge sensitive backup and restore data" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Save confirmed backup..." Click="OnWriteBackup"
                          IsEnabled="{Binding Privacy.CanWriteBackup}"
                          AutomationProperties.Name="Write confirmed sensitive backup" />
                  <Button Content="Restore backup as new records..." Click="OnRestoreBackup"
                          AutomationProperties.Name="Validate and restore sensitive backup without overwriting" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border BorderBrush="#9C3B3B" BorderThickness="1" CornerRadius="4" Padding="10">
              <StackPanel Spacing="8">
                <TextBlock FontSize="16" Text="Session retention" />
                <TextBlock Text="Applying retention permanently deletes older session metadata and raw traffic. Profiles are not deleted, and an active terminal session is always protected."
                           TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding Privacy.RetentionCountChoices}"
                          SelectedIndex="{Binding Privacy.RetentionCountIndex}"
                          Width="180" HorizontalAlignment="Left"
                          AutomationProperties.Name="Stored session retention limit" />
                <CheckBox IsChecked="{Binding Privacy.IsRetentionConfirmed}"
                          Content="I understand older sessions will be permanently deleted"
                          AutomationProperties.Name="Confirm permanent session retention deletion" />
                <Button Content="Apply retention now" Click="OnApplyRetention"
                        HorizontalAlignment="Left" AutomationProperties.Name="Apply confirmed session retention" />
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding Privacy.StatusText}" TextWrapping="Wrap"
                       AutomationProperties.Name="Privacy operation status" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
